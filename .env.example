# Local mode is the default. For Render Free set cloud and fill every secret.
TARIFF_STORAGE=local
DATABASE_URL=
S3_ENDPOINT_URL=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=tariff-app
APP_USERNAME=manager
# Explicit public mode skips login, including when APP_PASSWORD is still set.
# Public mode gives every visitor access to the shared prices, files and edits.
APP_AUTH_MODE=password
APP_PASSWORD=
TARIFF_DATA_DIR=./runtime
